{
  "name": "transly",
  "version": "0.4.0",
  "description": "A Chrome extension for context-aware AI translation using OpenAI-compatible APIs.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "capture:marketing": "node tools/capture-marketing.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "package": "npm run build && node tools/package-extension.mjs",
    "test": "npm run typecheck && npm run test:contracts && npm run test:e2e",
    "test:contracts": "node --test src/content/article-batching.test.mjs src/content/subtitle-core.test.mjs src/provider/*.test.mjs",
    "test:e2e": "TRANSLY_E2E=1 wxt build && TRANSLY_E2E=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
